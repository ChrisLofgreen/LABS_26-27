--FROM customers
--WHERE strftime('%m', joined_date) BETWEEN '01' AND '06'; 

-- 9. Which product has the longest name?
-- Look up: LENGTH · Expected: 1 row

--SELECT name 
--FROM products 
--ORDER BY length(name) DESC LIMIT 1;

-- 10. Show each customer's email username: the part before the @.
-- Look up: substr and instr · Expected: 10 row

--SELECT substr(email,1,instr(email, '@')-1)
--AS username
--FROM customers;


-- LEVEL 3

-- 11. Which products cost more than the average price? Don't type the average yourself: let SQL
-- calculate it inside the query.
-- Expected: 5 rows

--SELECT name, price 
--FROM products
--WHERE price &gt; (SELECT avg(price) FROM products)

