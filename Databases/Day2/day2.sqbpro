-- DAY 2: Exercises


-- 1.

CREATE TABLE books (
	book_id INTEGER PRIMARY KEY,
	title TEXT NOT NULL,
	author TEXT,
	year INTEGER
);

-- 2.

DROP TABLE books;

CREATE TABLE books (
	book_id INTEGER PRIMARY KEY,
	title TEXT NOT NULL,
	author TEXT,
	year INTEGER CHECK (year &gt; 1400)
);

-- 3.

ALTER TABLE books
	ADD COLUMN isbn TEXT;
	
-- 4.

DROP TABLE books;

-- 5.

CREATE TABLE reviews (
	review_id INTEGER NOT NULL,
	product_id INTEGER NOT NULL,
	rating REAL CHECK (rating &gt;= 1 AND rating &lt;= 5),
	comment TEXT,
	FOREIGN KEY (product_id) REFERENCES products(product_id)
);

-- 6.

INSERT INTO reviews (review_id, product_id, rating, comment)
VALUES (1, 1, 6, 'test');

-- This fails and gives error: &quot;Result: CHECK constraint failed: rating &gt;= 1 AND rating &lt;=5&quot;

-- 7.

INSERT INTO reviews (review_id, product_id, rating, comment)
VALUES (2, 50, 5, 'test2');

-- This fails and gives error: Result: &quot;FOREIGN KEY constraint failed&quot;

-- 8.

-- Customers (customer_id) -&gt; Orders
-- Orders and Products (order_id and product_id) -&gt; Order_items



-- Extra challenges: building tables

-- Level 1

-- 1.

CREATE TABLE suppliers (
	supplier_id INTEGER PRIMARY KEY,
	name TEXT NOT NULL UNIQUE,
	country TEXT DEFAULT 'Sweden',
	email TEXT
);

-- 2.

INSERT INTO suppliers (supplier_id, name, email)
VALUES (1, 'Test supplier', 'sup@sup.se');

SELECT * FROM suppliers;

-- Country column says 'Sweden'


-- 3.

INSERT INTO suppliers (supplier_id, name, email)
VALUES (2, 'Nordic Textiles', 'ntex@ntex.se');

INSERT INTO suppliers (supplier_id, name, email)
VALUES (3, 'Nordic Textiles', 'ntex@ntex.se');

-- The second INSERT shows error: &quot;Result: UNIQUE constraint failed: suppliers.name&quot;


-- 4.

CREATE TABLE coupons (
	coupon_code TEXT PRIMARY KEY,
	discount_percent REAL CHECK (discount_percent &gt;= 1 AND discount_percent &lt;= 90),
	valid_until TEXT NOT NULL
);

INSERT INTO coupons (coupon_code, discount_percent, valid_until)
VALUES ('AUTUMN26', 95, '2027-01-01');

-- INSERT shows error: &quot;Result: CHECK constraint failed: discount_percent &gt;= 1 AND discount_percent &lt;= 90&quot;</sql><current_tab id="0"/></tab_sql></sqlb_project>
