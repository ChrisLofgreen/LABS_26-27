-- Day 3 Exercises
-- Adding, changing and deleting data


-- 1.

PRAGMA table_info ('customers');

INSERT INTO customers (first_name, last_name, email, city, joined_date)
VALUES ('Christofer', 'Löfgreen', 'chlo@mail.com', 'Stockholm', '2026-10-07');

SELECT * FROM customers


-- 2.

PRAGMA table_info ('products');

INSERT INTO products (name, category, price, stock) VALUES
					('Scarf', 'Accessories', 229, 15),
					('Gloves', 'Accessories', 199, 20)
					
SELECT * FROM products


-- 3.

PRAGMA table_info ('orders');
PRAGMA table_info ('order_items');

INSERT INTO orders (customer_id, order_date)
VALUES (7, '2026-10-07');

INSERT INTO order_items (order_id, product_id, quantity, unit_price)
VALUES (16, 10, 2, 179);

SELECT * FROM orders
SELECT * FROM order_items


-- 4.

INSERT INTO order_items (order_id, product_id, quantity, unit_price)
VALUES (16, 10, 0, 179);

-- CHECK constraint failed: quantity &gt; 0, so the CHECK value on quantity (needs to be above 0)


-- 5.

SELECT status FROM orders WHERE order_id = 12;

UPDATE orders SET status = 'shipped' WHERE order_id = 12;


-- 6.

SELECT * FROM products;

UPDATE products SET stock = 50 WHERE product_id = 5;


-- 7.

SELECT * FROM products WHERE category = 'Accessories';

UPDATE products SET price = price * 1.1 WHERE category = 'Accessories';


-- 8.

SELECT * FROM orders
SELECT * FROM order_items

DELETE FROM order_items WHERE order_id = 7;
DELETE FROM orders WHERE order_id = 7;

-- order_items REFERENCES order_id from orders so if we remove the order first the referece is gone


-- 9.

-- Check!


-- 10.

-- Look at this table: student | phone_numbers | course1 | course2 | course3. List every problem you can find.

-- Problems:
--			 1. Lacks obvious PRIMARY KEY
--           2. 'student' is ambiguous, is it the name of the student? Then it should probably be called 'name' or two columns: 'first_name' and 'last_name'.
--              If it refers to some kind of status it should be named accordingly (ex. student_status), and the name could have to be another column
--           3. 'phone_numbers' implies that there could be serveral phone numbers in that cell, which is not a good idea (1NF)
--           4. The connection between the student and the courses are probably better expressed in a different table *student_courses* or something like that, 
--              and 'student_courses' would then in turn reference tables: 'students' and *courses*.


-- 11.

-- It breaks Normal Form 1 because there are serveral products on each row. One row per product and a column for quantity would fix it


-- 12. 

-- A table has: order_id | customer_id | customer_email | order_date. Which column is in the wrong place? Why?

-- 'customer_email' is in the wrong place. It breaks 2NF since it does not depend on the whole key ('order_id', 'customer_id'), it only depends on *customer_id'.



