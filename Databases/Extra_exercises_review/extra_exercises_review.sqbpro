-- Extra exercises: review


-- Level 1.

-- 1. 

SELECT * FROM products WHERE price BETWEEN 150 AND 500 AND (category = 'Clothing' OR category = 'Accessories') ORDER BY price DESC;


-- 2.

SELECT * FROM orders WHERE order_date LIKE '2026-02%' AND status != 'cancelled'


-- 3.

SELECT o.order_id, p.name product_name, oi.quantity, p.price * oi.quantity line_total
FROM order_items oi
JOIN orders o ON o.order_id = oi.order_id
JOIN products p ON p.product_id = oi.product_id
WHERE line_total &gt; 500
ORDER BY line_total DESC;


-- 4.

SELECT DISTINCT c.first_name, c.city
FROM orders o
JOIN customers c ON o.customer_id = c.customer_id
WHERE c.city = 'Uppsala' OR c.city = 'Stockholm';



-- Level 2.


-- 5.

PRAGMA table_info(customers);
PRAGMA table_info(orders);
PRAGMA table_info(order_items);

INSERT INTO customers (first_name, last_name, email, city, joined_date)
VALUES ('Leo', 'Falk', 'leo@falk.nu', 'Uppsala', '2026-10-09');

INSERT INTO orders (customer_id, order_date)
VALUES (11, '2026-10-09');

INSERT INTO order_items (order_id, product_id, quantity, unit_price)
VALUES
(16, 1, 1, 599),
(16, 9, 2, 129);

SELECT o.order_id, p.name product_name, oi.quantity, p.price * oi.quantity line_total
FROM order_items oi
JOIN orders o ON o.order_id = oi.order_id
JOIN products p ON p.product_id = oi.product_id
WHERE o.order_id = 16;


</sql><current_tab id="0"/></tab_sql></sqlb_project>
